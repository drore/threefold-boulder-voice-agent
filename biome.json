{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": ["**", "!!dist", "!!coverage", "!!node_modules"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noCommonJs": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@linear",
                      "@linear/*",
                      "@supabase",
                      "@supabase/*",
                      "fastify",
                      "fastify/*",
                      "openai",
                      "openai/*",
                      "react",
                      "react/*",
                      "node:module"
                    ],
                    "message": "The Application Core must not import provider, UI, or server framework modules."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
